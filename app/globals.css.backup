:root {
  --ink: #07111d;
  --navy: #0e2942;
  --navy-2: #17486f;
  --gold: #b99a61;
  --gold-soft: #d9c28f;
  --muted: #687582;
  --line: #e2e7ec;
  --paper: #f5f7f9;
  --white: #ffffff;
  --max: 1180px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--ink);
  background: var(--white);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

.container {
  width: min(var(--max), calc(100% - 40px));
  margin: 0 auto;
}

/* =========================
   NAVIGATION
========================= */

.nav-shell {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(226, 231, 236, 0.85);
}

.nav {
  height: 78px;
  width: min(var(--max), calc(100% - 40px));
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.brand,
.footer-brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.brand-mark {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, #07111d, #21557c);
  color: white;
  font-weight: 850;
  border-radius: 11px;
  letter-spacing: -0.06em;
  box-shadow: 0 10px 28px rgba(7, 17, 29, 0.2);
}

.brand strong {
  display: block;
  font-size: 15px;
  letter-spacing: -0.02em;
}

.brand small,
.footer-brand small {
  display: block;
  margin-top: 2px;
  font-size: 8px;
  letter-spacing: 0.18em;
  color: var(--muted);
}

.desktop-links {
  display: flex;
  gap: 28px;
  margin-left: auto;
}

.desktop-links a {
  position: relative;
  font-size: 13px;
  color: #46515c;
  transition: color 0.2s ease;
}

.desktop-links a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -7px;
  width: 0;
  height: 1px;
  background: var(--gold);
  transition: width 0.2s ease;
}

.desktop-links a:hover {
  color: var(--navy);
}

.desktop-links a:hover::after {
  width: 100%;
}

.nav-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: var(--ink);
  color: white;
  padding: 12px 18px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 700;
  transition: 0.25s ease;
}

.nav-cta:hover {
  background: var(--navy-2);
  transform: translateY(-2px);
}

.menu-btn {
  display: none;
  border: 0;
  background: none;
}

.mobile-menu {
  display: none;
}

/* =========================
   HERO
========================= */

.hero {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 80% 15%,
      rgba(185, 154, 97, 0.13),
      transparent 28%
    ),
    linear-gradient(135deg, #eef3f7 0%, #ffffff 58%, #f4f7fa 100%);
  border-bottom: 1px solid var(--line);
}

.hero::before {
  content: "";
  position: absolute;
  width: 620px;
  height: 620px;
  border: 1px solid rgba(185, 154, 97, 0.1);
  border-radius: 50%;
  right: -310px;
  top: -250px;
}

.hero-inner {
  min-height: 680px;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  gap: 70px;
  padding-top: 45px;
  padding-bottom: 45px;
}

.hero-copy {
  position: relative;
  z-index: 3;
}

.eyebrow {
  margin: 0 0 16px;
  color: var(--navy-2);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.2em;
}

.hero h1 {
  max-width: 760px;
  font-size: clamp(46px, 6vw, 76px);
  line-height: 0.97;
  letter-spacing: -0.065em;
  margin: 0 0 25px;
}

.hero p.lead {
  max-width: 650px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.72;
  margin: 0 0 34px;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.button {
  display: inline-flex;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 50px;
  padding: 0 20px;
  border-radius: 8px;
  font-weight: 750;
  font-size: 13px;
  border: 1px solid transparent;
}

.button-dark {
  background: var(--ink);
  color: white;
  box-shadow: 0 14px 30px rgba(7, 17, 29, 0.18);
}

.button-dark:hover {
  background: var(--navy-2);
  transform: translateY(-2px);
}

.button-light {
  background: white;
  color: var(--ink);
}

.button-light:hover {
  transform: translateY(-2px);
}

.button-outline {
  border-color: #c9d2da;
  background: rgba(255, 255, 255, 0.72);
}

.button-outline:hover {
  border-color: var(--navy-2);
  background: white;
  transform: translateY(-2px);
}

.hero-meta {
  display: flex;
  gap: 15px;
  margin-top: 35px;
  color: #6a7681;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  flex-wrap: wrap;
}

/* =========================
   HERO VISUAL
========================= */

.hero-art {
  min-height: 500px;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(202, 212, 221, 0.9);
  border-radius: 28px;
  background:
    radial-gradient(
      circle at 65% 28%,
      rgba(185, 154, 97, 0.16),
      transparent 24%
    ),
    linear-gradient(145deg, #dfe8ee, #f9fbfc 58%, #e8eef2);
  box-shadow: 0 40px 100px rgba(16, 37, 56, 0.14);
  isolation: isolate;
}

.hero-art::before {
  content: "";
  position: absolute;
  inset: 25px;
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: 22px;
}

.hero-art::after {
  content: "";
  position: absolute;
  width: 440px;
  height: 440px;
  border-radius: 50%;
  border: 1px solid rgba(23, 72, 111, 0.12);
  right: -180px;
  top: -150px;
}

.hero-art-glow {
  position: absolute;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: rgba(185, 154, 97, 0.1);
  filter: blur(45px);
  left: 25%;
  bottom: 10%;
}

.art-panel {
  position: absolute;
  inset: 55px;
  z-index: 3;
  padding: 25px;
  border: 1px solid rgba(208, 217, 224, 0.9);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 25px 80px rgba(16, 24, 40, 0.12);
  backdrop-filter: blur(14px);
}

.art-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--line);
}

.art-label {
  display: block;
  color: var(--gold);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.2em;
  margin-bottom: 5px;
}

.art-top strong {
  font-size: 16px;
  letter-spacing: -0.03em;
}

.art-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
}

.art-status span {
  width: 7px;
  height: 7px;
  background: #8eaa91;
  border-radius: 50%;
  box-shadow: 0 0 0 5px rgba(142, 170, 145, 0.12);
}

.art-map {
  height: 265px;
  position: relative;
  margin-top: 12px;
  overflow: hidden;
}

.map-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 1px solid rgba(23, 72, 111, 0.13);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.ring-one {
  width: 170px;
  height: 170px;
}

.ring-two {
  width: 270px;
  height: 270px;
  border-color: rgba(185, 154, 97, 0.16);
}

.map-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 230px;
  height: 1px;
  background: linear-gradient(90deg, transparent, #b8c6d1, transparent);
  transform-origin: center;
}

.line-one {
  transform: translate(-50%, -50%) rotate(25deg);
}

.line-two {
  transform: translate(-50%, -50%) rotate(-35deg);
}

.map-node {
  position: absolute;
  width: 11px;
  height: 11px;
  background: var(--gold);
  border: 3px solid white;
  border-radius: 50%;
  box-shadow: 0 5px 18px rgba(185, 154, 97, 0.3);
}

.node-one {
  left: 22%;
  top: 34%;
}

.node-two {
  right: 18%;
  top: 30%;
}

.node-three {
  right: 27%;
  bottom: 22%;
}

.central-node {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 68px;
  height: 68px;
  transform: translate(-50%, -50%);
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #0b1c2c, #1b527b);
  color: white;
  box-shadow: 0 20px 45px rgba(7, 17, 29, 0.25);
  animation: float 4s ease-in-out infinite;
}

.art-bottom {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
}

.art-bottom div {
  padding: 11px;
  background: #f5f8fa;
  border-radius: 9px;
}

.art-bottom small {
  display: block;
  color: #85919c;
  font-size: 7px;
  font-weight: 850;
  letter-spacing: 0.14em;
  margin-bottom: 5px;
}

.art-bottom strong {
  font-size: 11px;
}

/* =========================
   GENERAL SECTIONS
========================= */

.section {
  padding: 115px 0;
}

.section.alt {
  background: var(--paper);
}

.section-heading {
  max-width: 750px;
  margin-bottom: 54px;
}

.section-heading h2,
.page-hero h1,
.cta h2 {
  font-size: clamp(36px, 4.5vw, 58px);
  line-height: 1.02;
  letter-spacing: -0.055em;
  margin: 0 0 18px;
}

.section-heading > p:last-child {
  color: var(--muted);
  line-height: 1.75;
  font-size: 17px;
}

.display-title {
  max-width: 720px;
  margin: 0;
  font-size: clamp(38px, 5vw, 62px);
  line-height: 1;
  letter-spacing: -0.06em;
}

.intro-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 100px;
  align-items: start;
}

.intro-copy {
  padding-top: 42px;
}

.intro-copy p {
  color: var(--muted);
  line-height: 1.8;
  font-size: 16px;
  margin: 0 0 20px;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 12px;
  color: var(--navy-2);
  font-size: 13px;
  font-weight: 800;
  border-bottom: 1px solid rgba(23, 72, 111, 0.25);
  padding-bottom: 5px;
  transition: gap 0.2s ease;
}

.text-link:hover {
  gap: 11px;
}

/* =========================
   CARDS
========================= */

.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.card {
  position: relative;
  border: 1px solid var(--line);
  padding: 29px;
  border-radius: 16px;
  background: white;
  min-height: 265px;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
  overflow: hidden;
}

.card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, var(--gold), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.card:hover {
  transform: translateY(-7px);
  border-color: #cbd5de;
  box-shadow: 0 25px 60px rgba(17, 21, 26, 0.1);
}

.card:hover::before {
  opacity: 1;
}

.icon-box {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  background: #edf3f7;
  border-radius: 10px;
  color: var(--navy-2);
}

.card-index {
  color: var(--gold) !important;
  font-size: 9px !important;
  font-weight: 850 !important;
  letter-spacing: 0.12em;
  margin: 18px 0 0 !important;
}

.card h3 {
  margin: 8px 0 11px;
  font-size: 18px;
  letter-spacing: -0.025em;
}

.card p:last-of-type {
  color: var(--muted);
  line-height: 1.68;
  font-size: 14px;
  margin: 0;
}

.card-arrow {
  position: absolute;
  right: 24px;
  bottom: 23px;
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  color: #81909d;
  border: 1px solid #dfe5ea;
  border-radius: 50%;
  transition:
    color 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease;
}

.card:hover .card-arrow {
  color: white;
  background: var(--navy);
  transform: rotate(45deg);
}

/* =========================
   SERVICES
========================= */

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.service-item {
  position: relative;
  padding: 42px;
  min-height: 270px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: white;
  transition: background 0.3s ease;
}

.service-item:hover {
  background: #fbfcfd;
}

.service-number {
  position: absolute;
  top: 30px;
  right: 35px;
  color: var(--gold);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.12em;
}

.service-icon {
  width: 47px;
  height: 47px;
  display: grid;
  place-items: center;
  background: #edf3f7;
  color: var(--navy-2);
  border-radius: 11px;
  margin-bottom: 32px;
}

.service-item h3 {
  font-size: 22px;
  letter-spacing: -0.035em;
  margin: 0 0 12px;
}

.service-item p {
  max-width: 480px;
  color: var(--muted);
  line-height: 1.75;
  font-size: 14px;
  margin: 0;
}

/* =========================
   MEDIA / VISUAL SECTION
========================= */

.media-section {
  padding: 0 0 115px;
}

.media-panel {
  min-height: 560px;
  position: relative;
  overflow: hidden;
  border-radius: 24px;
  background:
    radial-gradient(
      circle at 75% 35%,
      rgba(185, 154, 97, 0.18),
      transparent 25%
    ),
    linear-gradient(135deg, #07111d, #102d47 60%, #0b1d2d);
  color: white;
  box-shadow: 0 35px 80px rgba(7, 17, 29, 0.18);
}

.media-content {
  position: relative;
  z-index: 4;
  max-width: 590px;
  padding: 75px;
}

.media-content .eyebrow {
  color: var(--gold-soft);
}

.media-content h2 {
  margin: 0 0 20px;
  font-size: clamp(40px, 5vw, 64px);
  line-height: 0.98;
  letter-spacing: -0.06em;
}

.media-content p:not(.eyebrow) {
  max-width: 530px;
  color: #b8c4ce;
  line-height: 1.75;
  font-size: 16px;
  margin-bottom: 30px;
}

.media-visual {
  position: absolute;
  width: 500px;
  height: 500px;
  right: -40px;
  top: 30px;
}

.media-orbit {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.orbit-one {
  width: 280px;
  height: 280px;
}

.orbit-two {
  width: 430px;
  height: 430px;
  border-color: rgba(185, 154, 97, 0.18);
}

.media-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100px;
  height: 100px;
  transform: translate(-50%, -50%);
  display: grid;
  place-items: center;
  align-content: center;
  gap: 7px;
  border-radius: 50%;
  background: linear-gradient(145deg, #1b4c70, #081522);
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
}

.media-center span {
  font-size: 7px;
  letter-spacing: 0.14em;
  font-weight: 850;
  color: #cbd6df;
}

.media-point {
  position: absolute;
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  background: white;
  color: var(--navy-2);
  border-radius: 50%;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
}

.point-a {
  left: 12%;
  top: 31%;
}

.point-b {
  right: 12%;
  top: 25%;
}

.point-c {
  right: 20%;
  bottom: 20%;
}

/* =========================
   PROCESS
========================= */

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  border-top: 1px solid var(--line);
}

.step {
  position: relative;
  padding: 31px 25px 20px 0;
  border-right: 1px solid var(--line);
  margin-right: 25px;
}

.step:last-child {
  border-right: 0;
}

.step-no {
  color: var(--gold);
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.14em;
}

.step h3 {
  font-size: 21px;
  margin: 30px 0 10px;
  letter-spacing: -0.03em;
}

.step p {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

.step-line {
  width: 35px;
  height: 2px;
  margin-top: 28px;
  background: var(--gold);
  transition: width 0.3s ease;
}

.step:hover .step-line {
  width: 65px;
}

/* =========================
   WHY NORTHBRIDGE
========================= */

.split {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 90px;
  align-items: start;
}

.section-heading-title {
  max-width: 600px;
  margin: 0 0 20px;
  font-size: clamp(38px, 4.5vw, 57px);
  line-height: 1.02;
  letter-spacing: -0.055em;
}

.section-description {
  max-width: 550px;
  color: var(--muted);
  line-height: 1.75;
  font-size: 16px;
}

.reason-list {
  border-top: 1px solid var(--line);
}

.reason-row {
  display: grid;
  grid-template-columns: 45px 1fr;
  gap: 15px;
  padding: 24px 0;
  border-bottom: 1px solid var(--line);
}

.reason-row > span {
  color: var(--gold);
  font-size: 11px;
  font-weight: 850;
  padding-top: 2px;
}

.reason-row div {
  display: flex;
  align-items: center;
  gap: 13px;
}

.reason-row svg {
  color: var(--navy-2);
  flex: 0 0 auto;
}

.reason-row strong {
  font-size: 16px;
  letter-spacing: -0.02em;
}

/* =========================
   UK FOCUS
========================= */

.uk-focus {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 35px;
  align-items: start;
  max-width: 1000px;
}

.uk-badge {
  width: 72px;
  height: 72px;
  display: grid;
  place-items: center;
  color: white;
  background: linear-gradient(145deg, var(--navy), var(--navy-2));
  border-radius: 17px;
  box-shadow: 0 16px 35px rgba(14, 41, 66, 0.18);
}

.uk-focus h2 {
  max-width: 800px;
  margin: 0 0 17px;
  font-size: clamp(34px, 4vw, 52px);
  line-height: 1.03;
  letter-spacing: -0.05em;
}

.uk-focus p:last-child {
  max-width: 750px;
  color: var(--muted);
  line-height: 1.8;
  font-size: 16px;
}

/* =========================
   CTA
========================= */

.cta {
  width: min(var(--max), calc(100% - 40px));
  margin: 0 auto 110px;
  padding: 66px;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 85% 20%,
      rgba(185, 154, 97, 0.15),
      transparent 28%
    ),
    var(--ink);
  color: white;
  border-radius: 22px;
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 35px;
  box-shadow: 0 30px 75px rgba(7, 17, 29, 0.17);
}

.cta::after {
  content: "";
  position: absolute;
  width: 350px;
  height: 350px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  right: -150px;
  bottom: -190px;
}

.cta h2 {
  max-width: 720px;
  margin-bottom: 12px;
}

.cta p:not(.eyebrow) {
  color: #adb9c3;
  max-width: 680px;
  line-height: 1.68;
}

/* =========================
   INNER PAGES
========================= */

.page-hero {
  padding: 105px 0 95px;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
}

.page-hero p {
  max-width: 720px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.72;
}

.prose {
  max-width: 850px;
}

.prose h2 {
  font-size: 30px;
  letter-spacing: -0.035em;
  margin: 55px 0 14px;
}

.prose p,
.prose li {
  color: var(--muted);
  line-height: 1.8;
  font-size: 16px;
}

.prose ul {
  padding-left: 20px;
}

/* =========================
   FORMS
========================= */

.form-layout {
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  gap: 80px;
}

.form-info h2 {
  font-size: 42px;
  letter-spacing: -0.045em;
  margin: 0 0 15px;
}

.form-info p {
  color: var(--muted);
  line-height: 1.7;
}

.contact-card {
  margin-top: 35px;
  padding: 22px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 10px;
}

.contact-card small {
  color: var(--muted);
  display: block;
  margin-bottom: 7px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 800;
  font-size: 10px;
}

.contact-card a {
  color: var(--navy-2);
  font-weight: 700;
  word-break: break-all;
}

.enquiry-form {
  display: grid;
  gap: 17px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px;
}

.enquiry-form label {
  display: grid;
  gap: 8px;
  font-size: 12px;
  font-weight: 800;
}

.enquiry-form input,
.enquiry-form textarea,
.enquiry-form select {
  width: 100%;
  border: 1px solid #d9dee4;
  border-radius: 7px;
  padding: 13px 14px;
  outline: none;
  background: white;
}

.enquiry-form textarea {
  resize: vertical;
}

.enquiry-form input:focus,
.enquiry-form textarea:focus,
.enquiry-form select:focus {
  border-color: var(--navy-2);
  box-shadow: 0 0 0 3px rgba(23, 63, 102, 0.08);
}

.form-note {
  color: #7a838d;
  font-size: 11px;
  line-height: 1.6;
}

.success-box {
  border: 1px solid #cdd9e3;
  background: #f5f9fc;
  border-radius: 12px;
  padding: 35px;
}

.success-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--navy-2);
  color: white;
  font-weight: 800;
}

.success-box h3 {
  margin-bottom: 8px;
}

.success-box p {
  color: var(--muted);
  line-height: 1.7;
}

/* =========================
   FAQ
========================= */

.faq {
  border-top: 1px solid var(--line);
}

.faq details {
  border-bottom: 1px solid var(--line);
  padding: 22px 0;
}

.faq summary {
  cursor: pointer;
  font-weight: 800;
}

.faq p {
  color: var(--muted);
  line-height: 1.7;
  max-width: 760px;
}

/* =========================
   FOOTER
========================= */

.footer {
  background: #07101a;
  color: white;
  padding: 78px 0 25px;
}

.footer-grid {
  width: min(var(--max), calc(100% - 40px));
  margin: auto;
  display: grid;
  grid-template-columns: 1.6fr 0.7fr 0.7fr 1fr;
  gap: 50px;
}

.footer-brand strong {
  display: block;
  font-size: 14px;
}

.footer-brand small {
  color: #8e98a3;
}

.footer-copy,
.footer-note {
  color: #89939e;
  line-height: 1.7;
  font-size: 13px;
  max-width: 360px;
}

.footer h4 {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: #9da7b1;
  margin: 0 0 18px;
}

.footer-grid > div:not(:first-child) {
  display: grid;
  align-content: start;
  gap: 11px;
}

.footer-grid a,
.footer-grid span {
  color: #d9dee3;
  font-size: 13px;
}

.footer-note {
  font-size: 11px;
  margin: 0;
}

.footer-bottom {
  width: min(var(--max), calc(100% - 40px));
  margin: 55px auto 0;
  padding-top: 22px;
  border-top: 1px solid #293038;
  display: flex;
  justify-content: space-between;
  gap: 25px;
  color: #737d87;
  font-size: 10px;
  line-height: 1.6;
}

/* =========================
   ANIMATIONS
========================= */

@keyframes float {
  0%,
  100% {
    transform: translate(-50%, -50%) translateY(0);
  }

  50% {
    transform: translate(-50%, -50%) translateY(-7px);
  }
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }

  50% {
    transform: scale(1.12);
    opacity: 0.72;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* =========================
   TABLET
========================= */

@media (max-width: 900px) {
  .desktop-links,
  .desktop-cta {
    display: none;
  }

  .menu-btn {
    display: block;
    color: var(--ink);
  }

  .mobile-menu {
    display: grid;
    width: min(var(--max), calc(100% - 40px));
    margin: 0 auto;
    padding: 10px 0 20px;
    gap: 4px;
  }

  .mobile-menu a {
    padding: 13px 4px;
  }

  .hero-inner,
  .split,
  .form-layout,
  .intro-grid {
    grid-template-columns: 1fr;
  }

  .hero-inner {
    padding: 80px 0;
  }

  .hero-art {
    min-height: 430px;
  }

  .card-grid {
    grid-template-columns: 1fr 1fr;
  }

  .service-grid {
    grid-template-columns: 1fr;
  }

  .steps {
    grid-template-columns: 1fr 1fr;
  }

  .step:nth-child(2) {
    border-right: 0;
  }

  .step:nth-child(n + 3) {
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }

  .split {
    gap: 50px;
  }

  .intro-copy {
    padding-top: 0;
  }

  .media-content {
    max-width: 100%;
    padding: 60px;
  }

  .media-visual {
    opacity: 0.35;
    right: -100px;
  }

  .cta {
    align-items: flex-start;
    flex-direction: column;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
}

/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {
  .container,
  .nav,
  .footer-grid,
  .footer-bottom {
    width: min(100% - 28px, var(--max));
  }

  .hero-inner {
    padding: 62px 0;
    gap: 45px;
  }

  .hero h1 {
    font-size: 45px;
  }

  .hero p.lead {
    font-size: 16px;
  }

  .hero-meta {
    gap: 9px;
    line-height: 1.7;
  }

  .hero-art {
    min-height: 350px;
    border-radius: 20px;
  }

  .art-panel {
    inset: 24px;
    padding: 18px;
  }

  .art-map {
    height: 190px;
  }

  .ring-two {
    width: 210px;
    height: 210px;
  }

  .ring-one {
    width: 130px;
    height: 130px;
  }

  .central-node {
    width: 55px;
    height: 55px;
  }

  .art-bottom {
    gap: 5px;
  }

  .art-bottom div {
    padding: 8px;
  }

  .art-bottom strong {
    font-size: 9px;
  }

  .section {
    padding: 78px 0;
  }

  .display-title,
  .section-heading-title {
    font-size: 40px;
  }

  .card-grid,
  .steps,
  .form-row,
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .card {
    min-height: 230px;
  }

  .service-item {
    min-height: 240px;
    padding: 32px 27px;
  }

  .step {
    border-right: 0;
    border-bottom: 1px solid var(--line);
    margin: 0;
    padding-right: 0;
  }

  .step:nth-child(n + 3) {
    border-top: 0;
  }

  .media-section {
    padding-bottom: 78px;
  }

  .media-panel {
    min-height: 590px;
    border-radius: 18px;
  }

  .media-content {
    padding: 42px 27px;
  }

  .media-content h2 {
    font-size: 42px;
  }

  .media-visual {
    width: 360px;
    height: 360px;
    right: -90px;
    top: 270px;
    opacity: 0.25;
  }

  .orbit-one {
    width: 210px;
    height: 210px;
  }

  .orbit-two {
    width: 320px;
    height: 320px;
  }

  .uk-focus {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .cta {
    width: calc(100% - 28px);
    margin-bottom: 75px;
    padding: 38px 26px;
  }

  .page-hero {
    padding: 78px 0;
  }

  .page-hero h1 {
    font-size: 44px;
  }

  .footer-bottom {
    flex-direction: column;
  }
}